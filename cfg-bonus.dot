digraph bonus {
  graph [rankdir=TB, fontname="Arial", fontsize=14, labelloc=t,
    label="bonus() CFG — line numbers from DataFlowTargets.java"];
  node [shape=box, style="rounded", fontname="Arial", fontsize=13];
  edge [fontname="Arial", fontsize=10];
  entry [label="31: bonus(attendance, threshold)"];
  valid [label="32: attendance == null || threshold < 0"];
  err [label="33: throw IllegalArgumentException"];
  init [label="35: present = 0\n36: streak = 0\n37: best = 0"];
  loop [label="38: for-each has next attendance element?\nP-use attendance; if yes, assign next element to a (def a)"];
  pos [label="39: a > 0"];
  inc [label="40: present = present + 1\n41: streak = streak + 1"];
  bestq [label="42: streak > best"];
  bestset [label="43: best = streak"];
  reset [label="46: streak = 0"];
  score0 [label="49: score = 0"];
  presentq [label="50: present >= threshold"];
  score5 [label="51: score = 5"];
  best5 [label="53: best >= 5"];
  score8 [label="54: score = score + 3"];
  ret [label="56: return score"];
  end [shape=point, label=""];
  entry -> valid;
  valid -> err [label="invalid: nullAttendance, negativeThreshold"];
  valid -> init [label="valid: resetNoBonus, presentStreakBonus, emptyArrayZeroThreshold, shortResetUnderThreshold, resetThenFive, longStreakUnderThreshold, m2KillCase"];
  err -> end [style=dashed];
  init -> loop;
  loop -> pos [label="next: resetNoBonus, presentStreakBonus, shortResetUnderThreshold, resetThenFive, longStreakUnderThreshold, m2KillCase"];
  loop -> score0 [label="done: emptyArrayZeroThreshold"];
  pos -> inc [label="a > 0: resetNoBonus, presentStreakBonus, shortResetUnderThreshold, resetThenFive, longStreakUnderThreshold, m2KillCase"];
  pos -> reset [label="a == 0: resetNoBonus, shortResetUnderThreshold, resetThenFive, m2KillCase"];
  inc -> bestq;
  bestq -> bestset [label="true: presentStreakBonus, resetThenFive, longStreakUnderThreshold, m2KillCase"];
  bestq -> loop [label="false: resetNoBonus, shortResetUnderThreshold, resetThenFive, m2KillCase"];
  bestset -> loop [label="next element: resetThenFive, longStreakUnderThreshold, m2KillCase"];
  reset -> loop [label="next element: shortResetUnderThreshold, resetThenFive, m2KillCase"];
  loop -> score0 [label="done after loop: resetNoBonus, presentStreakBonus, shortResetUnderThreshold, resetThenFive, longStreakUnderThreshold, m2KillCase"];
  score0 -> presentq;
  presentq -> score5 [label="true: presentStreakBonus, emptyArrayZeroThreshold, resetThenFive, m2KillCase"];
  presentq -> best5 [label="false: resetNoBonus, shortResetUnderThreshold, longStreakUnderThreshold"];
  score5 -> best5;
  best5 -> score8 [label="true: presentStreakBonus, resetThenFive, longStreakUnderThreshold"];
  best5 -> ret [label="false: resetNoBonus, emptyArrayZeroThreshold, shortResetUnderThreshold, m2KillCase"];
  score8 -> ret;
  ret -> end;
}
